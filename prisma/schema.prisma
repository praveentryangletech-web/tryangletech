// Prisma schema for TryangleTech
// Native Next.js App Router + Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. CONTACT SUBMISSIONS / LEADS (Contact Form)
// ----------------------------------------------------
model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String
  message   String   @db.Text
  subjects  String[] @default([])
  status    String   @default("NEW") // "NEW", "REVIEWED", "CONTACTED", "ARCHIVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([createdAt(sort: Desc)])
}

// ----------------------------------------------------
// 2. NEWSLETTER SUBSCRIBERS
// ----------------------------------------------------
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("ACTIVE") // "ACTIVE", "UNSUBSCRIBED"
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status, createdAt(sort: Desc)])
}

// ----------------------------------------------------
// 3. DYNAMIC BLOG POSTS & CMS
// ----------------------------------------------------
model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  excerpt     String?  @db.Text
  content     String   @db.Text
  coverImage  String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, publishedAt(sort: Desc)])
  @@index([slug])
  @@index([published, publishedAt(sort: Desc)])
}

// ----------------------------------------------------
// 4. SUPERADMIN AUTHENTICATION & USERS
// ----------------------------------------------------
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password in DB
  name      String   @default("Super Administrator")
  role      String   @default("SUPERADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ----------------------------------------------------
// 5. DYNAMIC PORTFOLIO & CASE STUDIES
// ----------------------------------------------------
model PortfolioProject {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  category     String   // e.g. "Business Website", "E-Commerce", "Mobile Application", "Custom Software", "Graphic Design", "Landing Website"
  image        String   @default("/portfolio/vh-accounting.webp")
  description  String   @db.Text
  client       String?
  duration     String?
  role         String?
  liveUrl      String?
  content      String?  @db.Text
  challenges   String[] @default([])
  solutions    String[] @default([])
  results      String[] @default([])
  technologies String[] @default([])
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // High-performance composite & single indexes for sub-millisecond lookups & sorting
  @@index([category, order, createdAt(sort: Desc)])
  @@index([order, createdAt(sort: Desc)])
  @@index([slug])
  @@index([createdAt(sort: Desc)])
  @@index([title, createdAt])
}
