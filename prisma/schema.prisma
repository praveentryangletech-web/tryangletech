// Prisma schema for TryangleTech
// Native Next.js App Router + Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. CONTACT SUBMISSIONS / LEADS (Contact Form)
// ----------------------------------------------------
model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String
  message   String   @db.Text
  subjects  String[] @default([])
  status    String   @default("NEW") // "NEW", "REVIEWED", "CONTACTED", "ARCHIVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([createdAt(sort: Desc)])
}

// ----------------------------------------------------
// 2. NEWSLETTER SUBSCRIBERS
// ----------------------------------------------------
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("ACTIVE") // "ACTIVE", "UNSUBSCRIBED"
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status, createdAt(sort: Desc)])
}

// ----------------------------------------------------
// 3. DYNAMIC BLOG POSTS & CMS
// ----------------------------------------------------
model BlogPost {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  category           String
  excerpt            String?  @db.Text
  content            String   @db.Text
  coverImage         String?
  images             String[] @default([])
  authorName         String?  @default("TryangleTech Team")
  authorRole         String?  @default("Content Creators")
  authorImage        String?
  authorBio          String?  @db.Text
  readTime           String?  @default("5 min read")
  published          Boolean  @default(true)
  publishedAt        DateTime @default(now())
  order              Int      @default(0)
  tags               String[] @default([])
  
  // Section-wise fields
  section1Heading    String?
  section1Paragraph1 String?  @db.Text
  section1Paragraph2 String?  @db.Text
  quoteText          String?  @db.Text
  quoteAuthor        String?
  stepsTitle         String?
  step1              String?  @db.Text
  step2              String?  @db.Text
  contentImage1      String?
  contentImage2      String?
  conclusionTitle    String?
  conclusionBody     String?  @db.Text
  conclusionPoints   String[] @default([])

  // SEO & AEO
  metaTitle          String?
  metaDescription    String?  @db.Text
  canonicalUrl       String?
  keywords           String[] @default([])
  viewsCount         Int      @default(0)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category, published, createdAt(sort: Desc)])
  @@index([slug])
  @@index([published, createdAt(sort: Desc)])
  @@index([order, createdAt(sort: Desc)])
}

// ----------------------------------------------------
// 4. SUPERADMIN AUTHENTICATION & USERS
// ----------------------------------------------------
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hashed password in DB
  name      String   @default("Super Administrator")
  role      String   @default("SUPERADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ----------------------------------------------------
// 5. DYNAMIC PORTFOLIO & CASE STUDIES
// ----------------------------------------------------
model PortfolioProject {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  category     String   // e.g. "Business Website", "E-Commerce", "Mobile Application", "Custom Software", "Graphic Design", "Landing Website"
  image        String   @default("/portfolio/vh-accounting.webp")
  imageAlt     String?
  description  String   @db.Text
  client       String?
  duration     String?
  role         String?
  liveUrl      String?
  content      String?  @db.Text
  challenges      String[] @default([])
  solutions       String[] @default([])
  results         String[] @default([])
  technologies    String[] @default([])
  images          String[] @default([])
  imageAlts       String[] @default([])
  metaTitle       String?
  metaDescription String?
  aeoSummary      String?
  keywords        String[] @default([])
  geoRegion       String?
  canonicalUrl    String?
  faqs            Json?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // High-performance composite & single indexes for sub-millisecond lookups & sorting
  @@index([category, order, createdAt(sort: Desc)])
  @@index([order, createdAt(sort: Desc)])
  @@index([slug])
  @@index([createdAt(sort: Desc)])
  @@index([title, createdAt])
}

// ----------------------------------------------------
// 6. DYNAMIC MEDIA ASSETS & UPLOADS
// ----------------------------------------------------
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String   @unique
  mimeType  String   @default("image/webp")
  size      Int      @default(0)
  data      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filename])
  @@index([updatedAt(sort: Desc)])
}

// ----------------------------------------------------
// 7. DYNAMIC CATEGORIES (PORTFOLIO, BLOG, ETC.)
// ----------------------------------------------------
model PortfolioCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String
  type      String   @default("PORTFOLIO") // "PORTFOLIO", "BLOG", etc.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, type])
  @@unique([slug, type])
  @@index([type, order, name])
  @@index([type, slug])
}

// ----------------------------------------------------
// 8. DYNAMIC PAGE-WISE FAQS (PORTFOLIO, BLOG, SERVICES)
// ----------------------------------------------------
model PageFAQ {
  id          String   @id @default(cuid())
  pageType    String   // e.g. "PORTFOLIO_MAIN", "PORTFOLIO_DETAIL", "BLOG_MAIN", "BLOG_DETAIL", "SERVICE_WEB", etc.
  pageId      String?  // project slug or blog slug (null for main page defaults)
  question    String
  answer      String   @db.Text
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageType, pageId, order])
  @@index([pageType, isPublished])
}
