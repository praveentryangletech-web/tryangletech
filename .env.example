# ==============================================================================
# Supabase PostgreSQL Connection Variables for TryangleTech
# ==============================================================================

# 1. Main Database URL (Transaction Pooler - Port 6543)
# Used by Next.js App Router, Route Handlers, and Vercel in production
DATABASE_URL="postgresql://postgres.ffwtjzmfaevtrnleufni:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct URL (Port 5432)
# Used by Prisma CLI for pushing schemas and running migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.ffwtjzmfaevtrnleufni.supabase.co:5432/postgres"

# Optional: Admin Secret Key for accessing protected API endpoints (e.g. GET /api/contact)
ADMIN_API_KEY="tryangle_secret_admin_key_2026"
NEXT_PUBLIC_ADMIN_API_KEY="tryangle_secret_admin_key_2026"

# Base Site URL for Vercel deployment & custom domain
NEXT_PUBLIC_BASE_URL="https://tryangletech.vercel.app"
NEXT_PUBLIC_SITE_URL="https://tryangletech.vercel.app"

# ==============================================================================
# Cloudinary Media Storage Driver Configuration (Global CDN for Vercel & Production)
# ==============================================================================
# Options: 'cloudinary' (exclusive) | 'hybrid' (Cloudinary + Supabase DB) | 'database' | 'local'
MEDIA_STORAGE_DRIVER="cloudinary"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
